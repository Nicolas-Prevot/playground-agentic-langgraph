# Copy this file to .env and fill in the model settings for live examples.
# .env is ignored by Git. Offline examples and tests need no credentials.
# Run: uv run --env-file .env python -m playground_agentic.scenarios.s01_structured.live_example

# Required: a LiteLLM provider/model identifier supported by your endpoint.
# Examples of the identifier format: openai/<model>, anthropic/<model>, ollama_chat/<model>
LLM_MODEL=

# API key for the chosen endpoint. You may use a provider-specific variable instead,
# such as OPENAI_API_KEY or ANTHROPIC_API_KEY. Do not commit actual credentials here.
LLM_API_KEY=

# Optional: leave empty for the provider's default URL.
# For a local OpenAI-compatible server, use its API root, e.g. http://localhost:8000/v1.
# Use LLM_API_KEY=not-required only when that server does not require authentication.
LLM_API_BASE=

# Maximum output tokens per model call, not a total workflow budget.
LLM_MAX_TOKENS=2048

# Optional scenario 10 observability lab; see docs/observability/README.md.
# console works without Docker; otlp sends all three signals over HTTP/protobuf.
PLAYGROUND_OTEL_EXPORTER=console
OTEL_SERVICE_NAME=langgraph-resumable-demo
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional authenticated backend headers, e.g. authorization=Bearer%20<token>.
# OTEL_EXPORTER_OTLP_HEADERS=
# The YAML profiles select parent-based ratio sampling and read this ratio.
OTEL_TRACES_SAMPLER_ARG=1.0
# Optional: path to your own SDK YAML profile. When set it overrides --export.
# OTEL_CONFIG_FILE=src/playground_agentic/scenarios/s10_resumable/otel-otlp.yaml
# Profiles explicitly read the variables above. Other OTEL_* SDK environment settings
# are not automatically merged with declarative configuration.
# Prompts, outputs and content upload stay disabled in the reference example.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
OTEL_INSTRUMENTATION_GENAI_EMIT_EVENT=false
# For --live, set the actual provider (e.g. openai, anthropic); otherwise use other.
# Model names/provider labels must be deployment configuration, never user input.
OTEL_GENAI_PROVIDER=other
